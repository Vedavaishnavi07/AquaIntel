# Development defaults: no secrets or real data. Copy to .env.
PORT=5173
APP_ORIGIN=http://localhost:5173
# Omit DATABASE_URL for local-only embedded PostgreSQL development.
# DATABASE_URL=postgresql://aquaintel:YOUR_PASSWORD@localhost:5432/aquaintel
LOCAL_DATA_DIR=.local/postgres
UPLOAD_DIR=.local/uploads
DEMO_MODE=false
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain, DATABASE_URL required.
# REGISTRATION_CODE=generate-a-long-private-pilot-invitation-code
TRUST_PROXY=0
