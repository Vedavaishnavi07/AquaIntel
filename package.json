{
  "name": "aquaintel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/server/index.ts",
    "build": "vite build --configLoader native && tsc -p tsconfig.server.json",
    "start": "node dist/server/apps/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests scripts",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "demo:seed": "node --import tsx scripts/seed.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "demo:serve": "node --import tsx scripts/demo-serve.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "4.2.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
